# ==============================================================
# VR Creation Company — Environment Variables
# Copiez ce fichier vers .env et renseignez vos valeurs.
# ==============================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Site
SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http

# Database (SQLite)
# DATABASE_PATH=./data/db.sqlite3

# Email (SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=vrcreation.company@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=VR Creation <vrcreation.company@gmail.com>
# CONTACT_EMAIL=vrcreation.company@gmail.com

# Google Gemini AI Blog Generator
# GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Google Analytics (loaded only after cookie consent)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Rate limiting
# CONTACT_RATE_LIMIT_SECONDS=60
# CONTACT_RATE_LIMIT_MAX=5

# Production only
# SECURE_SSL_REDIRECT=True
# LOG_FILE=./logs/django.log

